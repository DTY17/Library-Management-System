<UserControl x:Class="WPF.User_Control.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.User_Control"
             mc:Ignorable="d" 
             d:DesignHeight="510" d:DesignWidth="700" Width="700" Height="510" MinWidth="700" MaxWidth="700" MinHeight="510" MaxHeight="510">

    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="StatsCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E5E7EB" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards Section -->
        <Grid Grid.Row="0" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Books Card -->
            <Border Grid.Column="0" Style="{StaticResource StatsCard}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#EEF2FF" 
                                Width="40" Height="40" 
                                CornerRadius="10"
                                Margin="0,0,12,0">
                            <TextBlock Text="📚" 
                                       FontSize="20" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Books" 
                                   FontSize="14" 
                                   FontWeight="Medium"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Number -->
                    <TextBlock x:Name="BookLabel" 
                               Grid.Row="1"
                               Text="150" 
                               FontSize="42" 
                               FontWeight="Bold"
                               Foreground="#6366F1"
                               VerticalAlignment="Center"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <!-- Members Card -->
            <Border Grid.Column="1" Style="{StaticResource StatsCard}" Margin="7,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#ECFDF5" 
                                Width="40" Height="40" 
                                CornerRadius="10"
                                Margin="0,0,12,0">
                            <TextBlock Text="👥" 
                                       FontSize="20" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Members" 
                                   FontSize="14" 
                                   FontWeight="Medium"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Number -->
                    <TextBlock x:Name="MemberLabel" 
                               Grid.Row="1"
                               Text="35" 
                               FontSize="42" 
                               FontWeight="Bold"
                               Foreground="#10B981"
                               VerticalAlignment="Center"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <!-- Not Returned Card -->
            <Border Grid.Column="2" Style="{StaticResource StatsCard}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#FEF2F2" 
                                Width="40" Height="40" 
                                CornerRadius="10"
                                Margin="0,0,12,0">
                            <TextBlock Text="⚠️" 
                                       FontSize="20" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Not Returned" 
                                   FontSize="14" 
                                   FontWeight="Medium"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Number -->
                    <TextBlock x:Name="NotReturnedLabel" 
                               Grid.Row="1"
                               Text="21" 
                               FontSize="42" 
                               FontWeight="Bold"
                               Foreground="#EF4444"
                               VerticalAlignment="Center"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Recent Borrows Section -->
        <Border Grid.Row="1" 
                Background="White" 
                Margin="20,10,20,20" 
                CornerRadius="16" 
                Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#E5E7EB" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="54.94"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Border Grid.Row="0" 
                        BorderBrush="#E5E7EB" 
                        BorderThickness="0,0,0,1"
                        Padding="20,15" Margin="0,0,0,265" Grid.RowSpan="2">
                    <TextBlock Text="Recent Borrows" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                </Border>

                <!-- DataGrid -->
                <DataGrid x:Name="BooksTable"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          Margin="1,0,1,1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                        <DataGridTextColumn Header="Book Title" Binding="{Binding Book}" Width="*"/>
                        <DataGridTextColumn Header="Member" Binding="{Binding Member}" Width="*"/>
                        <DataGridTextColumn Header="Borrow Date" Binding="{Binding Date}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>