<UserControl x:Class="WPF.User_Control.Member"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.User_Control" xmlns:sys="http://schemas.microsoft.com/winfx/2009/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="610" d:DesignWidth="700" Height="610" Width="700" MinWidth="700" MinHeight="610" MaxWidth="700" MaxHeight="610">
    
    

    <UserControl.Resources>
        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#E0E7FF"
                        BorderThickness="2"
                        Padding="12,8">

                            <Grid>
                                <!-- Actual text content -->
                                <ScrollViewer x:Name="PART_ContentHost"/>

                                <!-- Placeholder -->
                                <TextBlock x:Name="Placeholder"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="Gray"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Opacity="0.6"
                                   Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Focus border color -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>

                            <!-- Show placeholder when empty -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Show placeholder when null -->
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>



        <!-- Modern DatePicker Style -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E7FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="380"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Form Section -->
        <Border Grid.Row="0" 
                Background="White" 
                Margin="20,20,20,10" 
                CornerRadius="16" 
                Padding="30,20">
            <Border.Effect>
                <DropShadowEffect Color="#E5E7EB" 
                                  BlurRadius="15" 
                                  ShadowDepth="2" 
                                  Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Text="Member Management" 
                           Grid.Row="0" 
                           Grid.ColumnSpan="5"
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#1F2937"
                           Margin="0,0,0,15"/>

                <!-- Left Column Labels -->
                <TextBlock Text="Full Name" Grid.Row="1" Grid.Column="0" 
                           Foreground="#4B5563" FontWeight="Medium" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Email" Grid.Row="2" Grid.Column="0" 
                           Foreground="#4B5563" FontWeight="Medium" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Phone" Grid.Row="3" Grid.Column="0" 
                           Foreground="#4B5563" FontWeight="Medium" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>

                <!-- Right Column Labels -->
                <TextBlock Text="NIC" Grid.Row="1" Grid.Column="3" 
                           Foreground="#4B5563" FontWeight="Medium" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Birthday" Grid.Row="2" Grid.Column="3" 
                           Foreground="#4B5563" FontWeight="Medium" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Address" Grid.Row="3" Grid.Column="3" 
                           Foreground="#4B5563" FontWeight="Medium" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>

                <!-- Left Column TextBoxes -->
                <TextBox x:Name="txtName"
                         Style="{StaticResource ModernTextBox}" 
                         Tag="Full Name"
                         Grid.Row="1" Grid.Column="1" 
                         VerticalAlignment="Center" 
                         Margin="0,5"/>
                <TextBox x:Name="txtEmail"
                         Style="{StaticResource ModernTextBox}" 
                         Tag="Email"
                         Grid.Row="2" Grid.Column="1" 
                         VerticalAlignment="Center" 
                         Margin="0,5"/>
                <TextBox x:Name="txtPhone"
                         Style="{StaticResource ModernTextBox}" 
                         Tag="Phone Number"
                         Grid.Row="3" Grid.Column="1" 
                         VerticalAlignment="Center" 
                         Margin="0,5"/>

                <!-- Right Column Inputs -->
                <TextBox x:Name="txtNIC"
                         Style="{StaticResource ModernTextBox}" 
                         Tag="NIC"
                         Grid.Row="1" Grid.Column="4" 
                         VerticalAlignment="Center" 
                         Margin="0,5"/>
                <DatePicker x:Name="dpBirthday"
                            Style="{StaticResource ModernDatePicker}"
                            Grid.Row="2" Grid.Column="4" 
                            VerticalAlignment="Center" 
                            Margin="0,0,0,5"/>
                <TextBox x:Name="txtAddress"
                         Style="{StaticResource ModernTextBox}" 
                         Tag="Address"
                         Grid.Row="3" Grid.Column="4" 
                         Grid.RowSpan="2"
                         VerticalAlignment="Top" 
                         Margin="0,5"
                         Height="88"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="5" 
                            Grid.Column="0" 
                            Grid.ColumnSpan="5" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button x:Name="btnAdd"
                            Content="Add Member" 
                            Style="{StaticResource ModernButton}"
                            Width="130" Height="38"
                            Margin="0,0,10,0" Click="btnAdd_Click"/>
                    <Button x:Name="btnUpdate"
                            Content="Update" 
                            Style="{StaticResource ModernButton}"
                            Width="110" Height="38"
                            Margin="0,0,10,0" Click="btnUpdate_Click"/>
                    <Button x:Name="btnDelete"
                            Content="Delete" 
                            Width="110" Height="38"
                            Margin="0,0,10,0" Click="btnDelete_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Background" Value="#EF4444"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btnClear"
                            Content="Clear" 
                            Width="110" Height="38" Click="btnClear_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Background" Value="#6B7280"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4B5563"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid Section -->
        <Border Grid.Row="1" 
                Background="White" 
                Margin="20,10,20,20" 
                CornerRadius="16" 
                Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#E5E7EB" 
                                  BlurRadius="15" 
                                  ShadowDepth="2" 
                                  Opacity="0.5"/>
            </Border.Effect>

            <DataGrid x:Name="MembersTable"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      Margin="1" PreviewMouseLeftButtonDown="ClickMemberTable">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="100"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                    <DataGridTextColumn Header="NIC" Binding="{Binding NIC}" Width="100"/>
                    <DataGridTextColumn Header="Birthday" Binding="{Binding Birthday, StringFormat=\{0:dd/MM/yyyy\}}" Width="90"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>

</UserControl>