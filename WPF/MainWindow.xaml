<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Library Management System"
        SizeToContent="Manual"
        Width="930" Height="715"
        MinWidth="930" MaxWidth="930"
        MinHeight="715" MaxHeight="715"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="10,0,10,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="Foreground" Value="#1F2937"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#6366F1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" 
                Grid.ColumnSpan="2"
                Background="#6366F1">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="25,0,0,0">
                    <TextBlock Text="📚" 
                               FontSize="24" 
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Library Management System"
                               FontWeight="Bold"
                               FontSize="20"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,25,0">
                    <Border x:Name="UserRole" Background="#5558E3"
                            CornerRadius="8"
                            Padding="15,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" 
                                       FontSize="16" 
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Administrator" 
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Grid.Column="0"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" 
                            Margin="0,20,0,0"
                            VerticalAlignment="Top">

                    <TextBlock Text="MAIN MENU" 
                               FontSize="11" 
                               FontWeight="Bold"
                               Foreground="#9CA3AF"
                               Margin="20,0,0,10"/>

                    <Button x:Name="HomeBtn"
                            Content="🏠  Home"
                            Style="{StaticResource ActiveSidebarButton}"
                            Height="42"
                            Click="ClickHomeBtn"
                            Margin="0,0,0,5"/>

                    <Button x:Name="BooksBtn"
                            Content="📖  Books"
                            Style="{StaticResource SidebarButton}"
                            Height="42"
                            Margin="0,0,0,5"
                            Click="ClickBookBtn"/>

                    <Button x:Name="MemberBtn" 
                            Content="👥  Members"
                            Style="{StaticResource SidebarButton}"
                            Height="42"
                            Margin="0,0,0,5"
                            Click="ClickMemberBtn"/>

                    <Button x:Name="RecordsBtn"
                            Content="📋  Records"
                            Style="{StaticResource SidebarButton}"
                            Height="42"
                            Margin="0,0,0,20" Click="ClickRecordsBtn"/>

                    <Separator Background="#E5E7EB" Margin="15,0"/>

                    <TextBlock Text="OTHER" 
                               FontSize="11" 
                               FontWeight="Bold"
                               Foreground="#9CA3AF"
                               Margin="20,20,0,10"/>

                    <Button x:Name="SettingsBtn"
                            Content="⚙️  Settings"
                            Style="{StaticResource SidebarButton}"
                            Height="42"
                            Margin="0,0,0,5" Click="clickSettings"/>
                </StackPanel>

                <Border Grid.Row="1" 
                        Background="Transparent"
                        Margin="15,0,15,15"
                        Padding="5">
                    <StackPanel>
                        <TextBlock Text="Version 1.0.0" 
                                   FontSize="10"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="© 2024 Library System" 
                                   FontSize="9"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="LoadPanel"
                Grid.Row="1" 
                Grid.Column="1"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
        </Border>
    </Grid>
</Window>